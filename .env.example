# URL publique du site (canonical, sitemap, Open Graph). À renseigner avant la mise en ligne.
NEXT_PUBLIC_SITE_URL=https://www.votre-domaine.fr

# Formulaire de contact : URL d'un webhook (Make, Zapier, n8n, Formspree, API maison…)
# qui recevra les messages en JSON. Sans cette variable, le formulaire reste inactif en production.
CONTACT_WEBHOOK_URL=
